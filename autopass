#!/usr/bin/env bash
set -euo pipefail

layout=${AUTOPASS_LAYOUT:-fr}   # disposition clavier pour dotool (KDE Wayland)

# ---------- détection de l'environnement ----------
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  backend=hyprland
elif [ "${XDG_SESSION_TYPE:-}" = wayland ] && command -v kdotool >/dev/null; then
  backend=kde-wayland
elif [ -n "${DISPLAY:-}" ] && command -v xdotool >/dev/null; then
  backend=x11
else
  notify-send autopass "Environnement non supporté"
  exit 1
fi

# ---------- fenêtre active : remplit $class et $title ----------
get_window() {
  local win id
  case $backend in
    hyprland)
      win=$(hyprctl activewindow -j)
      class=$(jq -r '.class' <<<"$win")
      title=$(jq -r '.title' <<<"$win")
      ;;
    kde-wayland)
      id=$(kdotool getactivewindow)
      class=$(kdotool getwindowclassname "$id")
      title=$(kdotool getwindowname "$id")
      ;;
    x11)
      id=$(xdotool getactivewindow)
      title=$(xdotool getwindowname "$id")
      class=$(xprop -id "$id" WM_CLASS | awk -F'"' '{print $4}')
      ;;
  esac
}

# ---------- saisie ----------
type_text() {
  local s=$1 i
  case $backend in
    hyprland)
      for ((i = 0; i < ${#s}; i++)); do
        printf '%s' "${s:i:1}" | wtype -
      done
      ;;
    kde-wayland)
      printf 'type %s\n' "$s" | DOTOOL_XKB_LAYOUT=$layout dotool
      ;;
    x11)
      printf '%s' "$s" | xdotool type --clearmodifiers --file -
      ;;
  esac
}

press() {   # $1 = tab | enter
  case $backend in
    hyprland)
      case $1 in tab) wtype -k Tab ;; enter) wtype -k Return ;; esac ;;
    kde-wayland)
      printf 'key %s\n' "$1" | DOTOOL_XKB_LAYOUT=$layout dotool ;;
    x11)
      case $1 in tab) xdotool key Tab ;; enter) xdotool key Return ;; esac ;;
  esac
}

# ---------- séquence de touches ----------
default_actions="user,tab,pass,enter"

# vérifie les étapes AVANT de taper quoi que ce soit
check_steps() {
  local step
  [ "$#" -gt 0 ] || return 1
  for step in "$@"; do
    case $step in user|pass|tab|enter|wait) ;; *) return 1 ;; esac
  done
}

run_steps() {
  local step
  for step in "$@"; do
    case $step in
      user)      type_text "$user" ;;
      pass)      type_text "$pw" ;;
      tab|enter) press "$step" ;;
      wait)      sleep 1 ;;
    esac
  done
}

# ---------- main ----------
get_window

if [ "${1:-}" = "--window" ]; then
  printf '%s\n%s\n' "$class" "$title"
  exit 0
fi

vault=$(pass show autopass/vault)

user=""; pw=""; actions=$default_actions; found=0
while IFS=';' read -r pattern u p; do
  case "$pattern" in ''|'#'*) continue ;; esac
  rule_actions=$default_actions
  # motif{étape,étape,...} : on sépare la séquence du motif (dernier '{')
  if [[ $pattern == *'{'*'}' ]]; then
    rule_actions=${pattern##*\{}
    rule_actions=${rule_actions%\}}
    pattern=${pattern%\{*}
  fi
  if [ "$pattern" = "$class" ] || [[ "$title" == *"$pattern"* ]]; then
    user=$u; pw=$p; actions=$rule_actions; found=1
    break
  fi
done <<<"$vault"
unset vault

if [ "$found" -eq 0 ]; then
  short=${title% — *}
  short=${short##*| }
  notify-send autopass "Aucune règle pour : ${short:-$class}"
  exit 1
fi

actions=${actions//[[:space:]]/}
IFS=',' read -ra steps <<<"${actions,,}"
if ! check_steps "${steps[@]}"; then
  notify-send autopass "Séquence invalide : {$actions}"
  exit 1
fi
run_steps "${steps[@]}"
