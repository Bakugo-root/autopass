#!/usr/bin/env bash
set -euo pipefail
shopt -s nocasematch   # patterns are case-insensitive

layout=${AUTOPASS_LAYOUT:-fr}               # keyboard layout for dotool (KDE Wayland)
clear_delay=${AUTOPASS_CLEAR_DELAY:-30}     # seconds before the copied password is cleared
add_delay=${AUTOPASS_ADD_DELAY:-3}          # seconds to click on the window with --add
dry_delay=${AUTOPASS_DRY_DELAY:-3}          # seconds to click on the window with --dry-run
window_delay=${AUTOPASS_WINDOW_DELAY:-3}    # seconds to click on the window with --window
default_actions="user,tab,pass,enter"

usage() {
  cat <<'EOF'
Usage: autopass [option]
  (none)       types the account matching the active window
  --window     prints the class then the title of the active window
  --dry-run    shows which rule(s) match, without typing anything
  --check      validates the vault (lines, patterns, sequences), without typing
  --add        adds an account to the vault from a window (run from a terminal)
  --list       lists the vault rules (never prints passwords)
  --edit       opens the vault in an editor, then checks it
  --remove     removes a rule, chosen in the menu
  --passwd     changes the password of a rule, chosen in the menu
  -h, --help   this help
EOF
}

die() {
  printf 'autopass: %s\n' "$1" >&2
  notify-send autopass "$1" 2>/dev/null || true
  exit 1
}

need() {
  local c
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || die "Missing tool: $c"
  done
}

# forces the GPG passphrase to be typed again: flushes the gpg-agent cache (fails closed)
reauth() {
  command -v gpgconf >/dev/null 2>&1 || die "gpgconf not found: cannot ask for the passphrase again"
  gpgconf --reload gpg-agent || die "Could not flush the gpg-agent cache: nothing was done"
}

# ---------- environment detection ----------
detect_backend() {
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    backend=hyprland
  elif [ "${XDG_SESSION_TYPE:-}" = wayland ] && command -v kdotool >/dev/null 2>&1; then
    backend=kde-wayland
  elif [ -n "${DISPLAY:-}" ] && command -v xdotool >/dev/null 2>&1; then
    backend=x11
  else
    die "Unsupported environment"
  fi
}

need_window_tools() {
  case $backend in
    hyprland)    need hyprctl jq ;;
    kde-wayland) need kdotool ;;
    x11)         need xdotool xprop ;;
  esac
}

need_type_tools() {
  case $backend in
    hyprland)    need wtype ;;
    kde-wayland) need dotool ;;
    x11)         need xdotool ;;
  esac
}

need_clip_tools() {
  case $backend in
    x11) need xclip ;;
    *)   need wl-copy wl-paste ;;
  esac
}

# ---------- active window: fills $class and $title ----------
get_window() {
  local win id
  case $backend in
    hyprland)
      win=$(hyprctl activewindow -j) || die "hyprctl failed"
      class=$(jq -r '.class // ""' <<<"$win") || die "Cannot read the active window"
      title=$(jq -r '.title // ""' <<<"$win") || die "Cannot read the active window"
      ;;
    kde-wayland)
      id=$(kdotool getactivewindow) || die "No active window"
      class=$(kdotool getwindowclassname "$id") || die "Window class not found"
      title=$(kdotool getwindowname "$id") || die "Window title not found"
      ;;
    x11)
      id=$(xdotool getactivewindow) || die "No active window"
      title=$(xdotool getwindowname "$id") || die "Window title not found"
      class=$(xprop -id "$id" WM_CLASS | awk -F'"' '{print $4}') || die "Window class not found"
      ;;
  esac
  [ -n "$class$title" ] || die "No active window"
}

# short title: without the browser suffix (after " — "), after the last "| "
short_title() {
  local t=${1% — *}
  printf '%s' "${t##*| }"
}

# ---------- typing ----------
type_text() {
  local s=$1 i
  case $backend in
    hyprland)
      for ((i = 0; i < ${#s}; i++)); do
        printf '%s' "${s:i:1}" | wtype - || die "Typing failed (wtype)"
      done
      ;;
    kde-wayland)
      printf 'type %s\n' "$s" | DOTOOL_XKB_LAYOUT=$layout dotool || die "Typing failed (dotool)"
      ;;
    x11)
      printf '%s' "$s" | xdotool type --clearmodifiers --file - || die "Typing failed (xdotool)"
      ;;
  esac
}

press() {   # $1 = tab | enter
  case $backend in
    hyprland)
      case $1 in tab) wtype -k Tab ;; enter) wtype -k Return ;; esac || die "Typing failed (wtype)" ;;
    kde-wayland)
      printf 'key %s\n' "$1" | DOTOOL_XKB_LAYOUT=$layout dotool || die "Typing failed (dotool)" ;;
    x11)
      case $1 in tab) xdotool key Tab ;; enter) xdotool key Return ;; esac || die "Typing failed (xdotool)" ;;
  esac
}

# ---------- clipboard (copy step) ----------
clip_set() {
  case $backend in
    x11) printf '%s' "$1" | xclip -selection clipboard ;;
    *)   printf '%s' "$1" | wl-copy --sensitive ;;
  esac
}

clip_get() {
  case $backend in
    x11) xclip -selection clipboard -o ;;
    *)   wl-paste --no-newline --type text ;;
  esac 2>/dev/null
}

clip_clear() {
  case $backend in
    x11) printf '' | xclip -selection clipboard ;;
    *)   wl-copy --clear ;;
  esac
}

# removes from the cliphist history the entry equal to the password (and only that one)
forget_history() {
  local lines
  command -v cliphist >/dev/null 2>&1 || return 0
  lines=$(cliphist list 2>/dev/null | awk '
    FNR == NR { p = $0; next }
    { i = index($0, "\t"); if (i && substr($0, i + 1) == p) print }
  ' <(printf '%s' "$1") -) || return 0
  if [ -n "$lines" ]; then
    printf '%s\n' "$lines" | cliphist delete 2>/dev/null || true
  fi
}

copy_secret() {
  local s=$1
  [ -n "$s" ] || die "Empty password: nothing to copy"
  clip_set "$s" || die "Copying to the clipboard failed"
  # delayed clear: only if the clipboard still holds this password
  (
    sleep "$clear_delay"
    if [ "$(clip_get || true)" = "$s" ]; then clip_clear || true; fi
    forget_history "$s"
  ) </dev/null >/dev/null 2>&1 &
  disown
  notify-send autopass "Password copied, cleared in ${clear_delay} s" 2>/dev/null || true
}

# ---------- key sequence ----------
step_ok() {
  case $1 in
    user|pass|tab|enter|wait|copy) return 0 ;;
    wait:*) [[ ${1#wait:} =~ ^[0-9]+(\.[0-9]+)?$ ]] ;;
    *) return 1 ;;
  esac
}

# checks the steps BEFORE typing anything
check_steps() {
  local step
  [ "$#" -gt 0 ] || return 1
  for step in "$@"; do
    step_ok "$step" || return 1
  done
}

run_steps() {
  local step
  for step in "$@"; do
    case $step in
      user)      type_text "$user" ;;
      pass)      type_text "$pw" ;;
      tab|enter) press "$step" ;;
      copy)      copy_secret "$pw" ;;
      wait)      sleep 1 ;;
      wait:*)    sleep "${step#wait:}" ;;
    esac
  done
}

# ---------- vault ----------
load_vault() {
  vault=$(pass show autopass/vault) \
    || die "Vault unreadable (GPG passphrase cancelled or autopass/vault missing)"
}

# writes the whole vault text; never writes an empty entry
write_vault() {
  local text=$1
  [[ $text =~ [^[:space:]] ]] || text='# autopass vault: one line per account, pattern;username;password'
  printf '%s\n' "$text" | pass insert -m -f autopass/vault >/dev/null || die "Writing the vault failed"
}

# random password of $1 characters (letters, digits and a few symbols; never ';')
gen_password() {
  local n=$1 all
  [[ $n =~ ^[0-9]+$ ]] && [ "$n" -ge 8 ] && [ "$n" -le 128 ] || die "Invalid length (8 to 128)"
  # filter a big block of random bytes: no modulo bias, no SIGPIPE under pipefail
  all=$(head -c 8192 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9!@#%^&*_=+.?-')
  [ "${#all}" -ge "$n" ] || die "Not enough randomness available"
  printf '%s' "${all:0:n}"
}

# asks for a password into $newpw: typed twice, or generated when left empty (never displayed)
ask_password() {
  local pw2 n
  printf 'Password (Enter = generate): ' >&2
  IFS= read -rs newpw || die "Input interrupted"; printf '\n' >&2
  if [ -z "$newpw" ]; then
    printf 'Length [20]: ' >&2
    IFS= read -r n || die "Input interrupted"
    newpw=$(gen_password "${n:-20}") || exit 1
    printf 'Generated a %s-character password (not displayed)\n' "${#newpw}" >&2
  else
    printf 'Confirm: ' >&2
    IFS= read -rs pw2 || die "Input interrupted"; printf '\n' >&2
    [ "$newpw" = "$pw2" ] || die "The two passwords differ: nothing was changed"
  fi
}

# fills the r_* arrays (one slot per rule) from $vault
parse_vault() {
  r_pat=(); r_user=(); r_pw=(); r_seq=(); r_seqok=(); r_line=(); r_err=()
  local n=0 line pattern rest u p seq err rc re st
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    case $line in ''|'#'*) continue ;; esac
    err=""; seq=$default_actions
    if [[ $line != *';'*';'* ]]; then
      err="malformed line (expected: pattern;username;password)"
      pattern=""; u=""; p=""
    else
      pattern=${line%%;*}; rest=${line#*;}; u=${rest%%;*}; p=${rest#*;}
    fi
    # pattern{step,step,...}: the sequence is after the last '{'
    if [[ $pattern == *'{'*'}' ]]; then
      seq=${pattern##*\{}
      seq=${seq%\}}
      pattern=${pattern%\{*}
    fi
    seq=${seq//[[:space:]]/}
    seq=${seq,,}
    if [ -z "$err" ] && [ -z "$pattern" ]; then err="empty pattern"; fi
    if [ -z "$err" ] && [[ $pattern == re:* ]]; then
      re=${pattern#re:}
      if [ -z "$re" ]; then
        err="empty regex"
      else
        rc=0
        [[ "" =~ $re ]] || rc=$?
        if [ "$rc" -eq 2 ]; then err="invalid regex"; fi
      fi
    fi
    IFS=',' read -ra st <<<"$seq" || true
    if [ "${#st[@]}" -gt 0 ] && check_steps "${st[@]}"; then rc=1; else rc=0; fi
    r_pat+=("$pattern"); r_user+=("$u"); r_pw+=("$p"); r_seq+=("$seq")
    r_seqok+=("$rc"); r_line+=("$n"); r_err+=("$err")
  done <<<"$vault"
}

# does the rule (pattern) match the active window?
# plain pattern: equal to the class, or contained in the title. "re:...": regex on the class or title.
rule_matches() {
  local p=$1 re
  if [[ $p == re:* ]]; then
    re=${p#re:}
    [[ $class =~ $re || $title =~ $re ]]
  else
    [[ $class == "$p" || $title == *"$p"* ]]
  fi
}

# fills the matches array with the indexes of the matching rules
find_matches() {
  local i
  matches=()
  for i in "${!r_pat[@]}"; do
    if [ -z "${r_err[i]}" ] && rule_matches "${r_pat[i]}"; then matches+=("$i"); fi
  done
}

# do all matching rules give exactly the same account and sequence?
matches_identical() {
  local i f=${matches[0]}
  for i in "${matches[@]}"; do
    [ "${r_user[i]}|${r_pw[i]}|${r_seq[i]}" = "${r_user[f]}|${r_pw[f]}|${r_seq[f]}" ] || return 1
  done
}

# choice menu when several accounts match: fills $sel, or exits without typing
pick_menu() {
  local m=${AUTOPASS_MENU:-} c i k out
  local -a cmd
  if [ -z "$m" ]; then
    for c in "fuzzel --dmenu" "wofi --dmenu" "rofi -dmenu" bemenu tofi; do
      if command -v "${c%% *}" >/dev/null 2>&1; then m=$c; break; fi
    done
  fi
  [ -n "$m" ] || die "No menu installed (fuzzel, wofi, rofi, bemenu, tofi): nothing was done"
  read -ra cmd <<<"$m"
  out=$(
    for k in "${!matches[@]}"; do
      i=${matches[k]}
      printf '%d) %s — %s  [line %s]\n' "$((k + 1))" "${r_pat[i]:-(malformed line)}" "${r_user[i]}" "${r_line[i]}"
    done | "${cmd[@]}"
  ) || exit 0   # menu cancelled: do nothing
  k=${out%%')'*}
  if ! [[ $k =~ ^[0-9]+$ ]] || [ "$k" -lt 1 ] || [ "$k" -gt "${#matches[@]}" ]; then exit 0; fi
  sel=${matches[k - 1]}
}

# ---------- commands ----------
cmd_window() {
  detect_backend
  need_window_tools
  printf 'Click on the window to inspect: capture in %s s…\n' "$window_delay" >&2
  sleep "$window_delay"
  get_window
  printf '%s\n%s\n' "$class" "$title"
}

cmd_check() {
  need pass
  load_vault
  parse_vault
  local i j errs=0 warns=0
  for i in "${!r_pat[@]}"; do
    if [ -n "${r_err[i]}" ]; then
      if [ -n "${r_pat[i]}" ]; then
        printf 'ERROR line %s (%s): %s\n' "${r_line[i]}" "${r_pat[i]}" "${r_err[i]}"
      else
        printf 'ERROR line %s: %s\n' "${r_line[i]}" "${r_err[i]}"
      fi
      errs=$((errs + 1))
      continue
    fi
    if [ "${r_seqok[i]}" -ne 1 ]; then
      printf 'ERROR line %s (%s): invalid sequence {%s}\n' "${r_line[i]}" "${r_pat[i]}" "${r_seq[i]}"
      errs=$((errs + 1))
    fi
    for ((j = 0; j < i; j++)); do
      [ -z "${r_err[j]}" ] || continue
      if [[ ${r_pat[i]} == "${r_pat[j]}" ]] && [ "${r_user[i]}|${r_pw[i]}|${r_seq[i]}" != "${r_user[j]}|${r_pw[j]}|${r_seq[j]}" ]; then
        printf 'WARNING line %s (%s): same pattern as line %s with a different account (a menu will be shown)\n' \
          "${r_line[i]}" "${r_pat[i]}" "${r_line[j]}"
        warns=$((warns + 1))
        break
      fi
    done
  done
  printf '%d rule(s), %d error(s), %d warning(s)\n' "${#r_pat[@]}" "$errs" "$warns"
  [ "$errs" -eq 0 ]
}

cmd_add() {
  local store_dir=${PASSWORD_STORE_DIR:-$HOME/.password-store}
  local choice pattern user pw seq entry i st dup="" ans newpw
  local -a steps
  need pass
  detect_backend
  need_window_tools
  printf 'Click on the window to record: capture in %s s…\n' "$add_delay" >&2
  sleep "$add_delay"
  get_window
  notify-send autopass "Window captured: go back to the terminal" 2>/dev/null || true
  st=$(short_title "$title")
  printf 'Window: class = %s | title = %s\n' "$class" "$title" >&2
  printf 'Pattern:\n  1) class: %s\n  2) short title: %s\n  3) free input\n' "$class" "$st" >&2
  printf 'Choice [1]: ' >&2
  IFS= read -r choice || die "Input interrupted"
  case ${choice:-1} in
    1) pattern=$class ;;
    2) pattern=$st ;;
    3) printf 'Pattern: ' >&2; IFS= read -r pattern || die "Input interrupted" ;;
    *) die "Invalid choice" ;;
  esac
  [ -n "$pattern" ] || die "Empty pattern"
  [[ $pattern != *';'* ]] || die "The pattern cannot contain ';'"
  printf 'Username: ' >&2
  IFS= read -r user || die "Input interrupted"
  [[ $user != *';'* ]] || die "The username cannot contain ';'"
  ask_password
  pw=$newpw
  printf 'Sequence [%s] (Enter = default): ' "$default_actions" >&2
  IFS= read -r seq || die "Input interrupted"
  seq=${seq//[[:space:]]/}
  seq=${seq,,}
  if [ -n "$seq" ]; then
    IFS=',' read -ra steps <<<"$seq" || true
    if [ "${#steps[@]}" -eq 0 ] || ! check_steps "${steps[@]}"; then die "Invalid sequence: {$seq}"; fi
  elif [[ $pattern == *'}' ]]; then
    seq=$default_actions   # a pattern ending with } requires an explicit sequence
  fi
  entry=$pattern
  if [ -n "$seq" ]; then entry="$pattern{$seq}"; fi
  entry="$entry;$user;$pw"

  vault=""
  if [ -f "$store_dir/autopass/vault.gpg" ]; then
    load_vault   # failure = stop: never overwrite an existing vault
    parse_vault
    for i in "${!r_pat[@]}"; do
      if [[ ${r_pat[i]} == "$pattern" ]]; then dup=${r_line[i]}; break; fi
    done
  fi
  if [ -n "$dup" ]; then
    printf 'A rule already exists for this pattern (line %s). Add anyway? [y/N] ' "$dup" >&2
    IFS= read -r ans || ans=n
    [[ $ans == [yY]* ]] || { printf 'Cancelled.\n' >&2; exit 0; }
  fi
  if [ -n "$vault" ]; then vault=$vault$'\n'$entry; else vault=$entry; fi
  write_vault "$vault"
  printf 'Added: %s → %s\n' "$pattern" "$user"
}

cmd_list() {
  local i
  need pass
  reauth
  load_vault
  parse_vault
  [ "${#r_pat[@]}" -gt 0 ] || { printf '(empty vault)\n'; return 0; }
  for i in "${!r_pat[@]}"; do
    if [ -n "${r_err[i]}" ]; then
      printf 'line %s: (%s)\n' "${r_line[i]}" "${r_err[i]}"
    else
      printf 'line %s: %s → %s  {%s}\n' "${r_line[i]}" "${r_pat[i]}" "${r_user[i]}" "${r_seq[i]}"
    fi
  done
}

cmd_edit() {
  local ed=${EDITOR:-} c
  need pass
  reauth
  [ -n "$ed" ] || ed=${VISUAL:-}
  if [ -z "$ed" ]; then
    for c in nano vim nvim vi micro; do
      if command -v "$c" >/dev/null 2>&1; then ed=$c; break; fi
    done
  fi
  [ -n "$ed" ] || die "No editor found: set EDITOR (for example EDITOR=nano)"
  env EDITOR="$ed" pass edit autopass/vault || die "pass edit failed"
  cmd_check || true   # shows what is wrong, if anything
}

# chooses one rule of the vault in the menu: fills $sel and $raw (raw vault lines)
pick_rule() {
  need pass
  reauth
  load_vault
  parse_vault
  [ "${#r_pat[@]}" -gt 0 ] || die "The vault has no rule"
  matches=("${!r_pat[@]}")
  pick_menu
  mapfile -t raw <<<"$vault"
}

cmd_remove() {
  local ans
  local -a raw
  pick_rule
  printf 'Remove line %s (%s → %s)? [y/N] ' "${r_line[sel]}" "${r_pat[sel]:-malformed line}" "${r_user[sel]}" >&2
  IFS= read -r ans || ans=n
  [[ $ans == [yY]* ]] || { printf 'Cancelled.\n' >&2; exit 0; }
  unset "raw[$((r_line[sel] - 1))]"
  write_vault "$(printf '%s\n' "${raw[@]}")"
  printf 'Removed line %s\n' "${r_line[sel]}"
}

cmd_passwd() {
  local newpw prefix line ln
  local -a raw
  pick_rule
  [ -z "${r_err[sel]}" ] || die "This line is malformed: fix it with autopass --edit"
  ask_password
  ln=$((r_line[sel] - 1))
  line=${raw[ln]}
  prefix=${line%%;*}; line=${line#*;}; prefix=$prefix';'${line%%;*}
  raw[ln]="$prefix;$newpw"
  write_vault "$(printf '%s\n' "${raw[@]}")"
  printf 'Password updated: %s → %s\n' "${r_pat[sel]}" "${r_user[sel]}"
}

# typing / dry-run: $1 = dry (1) or not (0)
cmd_type() {
  local dry=$1 i k short old_class old_title
  local -a steps
  detect_backend
  need_window_tools
  if [ "$dry" -eq 1 ]; then
    printf 'Click on the window to test: capture in %s s…\n' "$dry_delay" >&2
    sleep "$dry_delay"
  fi
  get_window
  need pass
  load_vault
  parse_vault
  find_matches
  unset vault

  if [ "${#matches[@]}" -eq 0 ]; then
    short=$(short_title "$title")
    if [ "$dry" -eq 1 ]; then
      printf 'No rule for: %s\n' "${short:-$class}"
      exit 1
    fi
    die "No rule for: ${short:-$class}"
  fi

  if [ "$dry" -eq 1 ]; then
    printf 'Window: class = %s | title = %s\n' "$class" "$title"
    for k in "${!matches[@]}"; do
      i=${matches[k]}
      printf 'Rule line %s: %s → %s  {%s}%s\n' "${r_line[i]}" "${r_pat[i]}" "${r_user[i]}" "${r_seq[i]}" \
        "$([ "${r_seqok[i]}" -eq 1 ] || printf '  (INVALID SEQUENCE)')"
    done
    if [ "${#matches[@]}" -eq 1 ] || matches_identical; then
      printf 'Result: direct typing\n'
    else
      printf 'Result: choice menu (several different accounts)\n'
    fi
    exit 0
  fi

  if [ "${#matches[@]}" -eq 1 ] || matches_identical; then
    sel=${matches[0]}
  else
    pick_menu
    # the menu may have changed the focus: only type if the window is the same
    old_class=$class; old_title=$title
    get_window
    if [ "$class" != "$old_class" ] || [ "$title" != "$old_title" ]; then
      die "The active window changed during the choice: nothing was typed"
    fi
  fi

  user=${r_user[sel]}; pw=${r_pw[sel]}
  [ "${r_seqok[sel]}" -eq 1 ] || die "Invalid sequence: {${r_seq[sel]}}"
  IFS=',' read -ra steps <<<"${r_seq[sel]}"
  for k in "${steps[@]}"; do
    case $k in
      copy) need_clip_tools ;;
      user|pass|tab|enter) need_type_tools ;;
    esac
  done
  run_steps "${steps[@]}"
}

# ---------- main ----------
case ${1:-} in
  '')          cmd_type 0 ;;
  --dry-run)   cmd_type 1 ;;
  --window)    cmd_window ;;
  --check)     cmd_check ;;
  --add)       cmd_add ;;
  --list)      cmd_list ;;
  --edit)      cmd_edit ;;
  --remove)    cmd_remove ;;
  --passwd)    cmd_passwd ;;
  -h|--help)   usage ;;
  *)           usage >&2; exit 2 ;;
esac
